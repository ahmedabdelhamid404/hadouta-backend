# Hadouta Backend — Environment Variables
# Copy to .env (which is gitignored) and fill in real values

# ----- Server -----
NODE_ENV=development
PORT=3001

# ----- Database (Neon Postgres) -----
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/hadouta?sslmode=require

# ----- Auth (Better-Auth) -----
BETTER_AUTH_SECRET=                # REQUIRED — generate via: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=                  # optional in dev; set both ID + SECRET to enable Google OAuth
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=                # reserved for Sprint 2
FACEBOOK_CLIENT_SECRET=

# ----- AI providers -----
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/
FAL_API_KEY=                       # https://fal.ai/dashboard/keys

# ----- Workflow (Trigger.dev) -----
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# ----- AI observability (Helicone) -----
HELICONE_API_KEY=

# ----- Object storage (Cloudflare R2) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hadouta-uploads
R2_PUBLIC_URL=https://r2.hadouta.com   # custom domain pointing to R2 bucket

# ----- Email (Resend) -----
RESEND_API_KEY=                    # optional in dev — falls back to console logging when blank
RESEND_FROM_EMAIL=Hadouta <noreply@mail.hadouta.com>

# ----- WhatsApp (Twilio) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886    # sandbox number; replace with real Egypt number after approval

# ----- Payment (Paymob) -----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_VODAFONE_CASH=
PAYMOB_INTEGRATION_ID_INSTAPAY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# ----- Errors (Sentry) -----
SENTRY_DSN=

# ----- Frontend reference (CORS) -----
FRONTEND_URL=http://localhost:3000
