# Hadouta Backend — Environment Variables
# Copy to .env (which is gitignored) and fill in real values

# ----- Server -----
NODE_ENV=development
PORT=3001

# ----- Database (Neon Postgres) -----
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/hadouta?sslmode=require

# ----- Auth (Better-Auth) -----
BETTER_AUTH_SECRET=                # REQUIRED — generate via: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=                  # optional in dev; set both ID + SECRET to enable Google OAuth
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=                # reserved for Sprint 2
FACEBOOK_CLIENT_SECRET=

# ----- AI providers -----
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/
FAL_API_KEY=                       # https://fal.ai/dashboard/keys

# ----- Workflow (Trigger.dev) -----
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# ----- AI observability (Helicone) -----
HELICONE_API_KEY=

# ----- Object storage (Cloudflare R2) — Phase 5 Task 1.9 -----
# Source of truth for these values is the UMBRELLA .env.local
# (/home/ahmed/Desktop/hadouta/.env.local) — fill them in there, then run
# `pnpm tsx ../scripts/sync-r2-to-railway.ts` (TBD) OR set manually:
#   railway variables --set R2_ACCOUNT_ID="..." (use --stdin pattern for secrets)
# See umbrella .env.example for how to obtain each value from Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hadouta-photos
R2_PUBLIC_URL=                         # https://pub-<id>.r2.dev (free, instant) for MVP;
                                       # https://photos.hadouta.com (Track B custom domain) later

# ----- Email (Resend) -----
RESEND_API_KEY=                    # optional in dev — falls back to console logging when blank
RESEND_FROM_EMAIL=Hadouta <noreply@mail.hadouta.com>

# ----- WhatsApp + SMS (Twilio) — ADR-018 phone-first OTP -----
TWILIO_ACCOUNT_SID=                  # https://console.twilio.com (Account SID)
TWILIO_AUTH_TOKEN=                   # auth token from same dashboard
TWILIO_WHATSAPP_FROM=+14155238886    # WhatsApp sandbox number for dev; replace with FB-Business-verified Egypt number for prod
TWILIO_SMS_FROM=                     # SMS sender ID (NTRA-registered for production); tier-2 OTP fallback per ADR-018
TWILIO_MESSAGING_SERVICE_SID=        # optional — Messaging Service SID for declarative WhatsApp→SMS fallback

# ----- Payment (Paymob) -----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_VODAFONE_CASH=
PAYMOB_INTEGRATION_ID_INSTAPAY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# ----- Errors (Sentry) -----
SENTRY_DSN=                          # https://sentry.io project DSN for hadouta-backend

# ----- Frontend reference (CORS) -----
FRONTEND_URL=http://localhost:3000
